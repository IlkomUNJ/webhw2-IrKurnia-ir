<!DOCTYPE html>
<html>
<head>
  @if ($slots.meta)
    {{{ await $slots.meta() }}}
  @endif
  <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Atheria - Online Parfume Shop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Optional: Add smooth transition for hover effects */
        .product-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }
    </style>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</head>
<body>
  
    {{-- Your site header --}}
    @if ($slots.header)
    {{{
      await $slots.header()
    }}}
    @else
      <header class="bg-white shadow-md sticky top-0 z-50">
        <div class="container mx-auto px-4 flex flex-col">
            <!-- Navigation at the top -->
            <nav class="hidden md:flex justify-end space-x-6 text-gray-600 font-medium py-2 border-b">
                <a href="/" class="hover:text-indigo-600 transition duration-300">Home</a>
                <a href="#" class="hover:text-indigo-600 transition duration-300">Shop</a>
                <a href="/about" class="hover:text-indigo-600 transition duration-300">About</a>
                <a href="/contact" class="hover:text-indigo-600 transition duration-300">Contact</a>
            </nav>

            <!-- Title and Search Bar -->
            <div class="flex items-center justify-between py-4">
                <a href="#" class="text-2xl font-garamond text-black-800 tracking-wider">Aethe<span class="text-black-600">ria</span></a>
                
                <div class="flex-grow max-w-4xl mx-auto px-4">
                    <form action="/search" method="get" class="flex items-center border border-gray-300 rounded-lg overflow-hidden">
                        <input 
                            name="query"
                            type="search" 
                            placeholder="Search products, categories..." 
                            value="{{ typeof query !== 'undefined' ? query : '' }}"
                            class="w-full px-4 py-2.5 text-gray-700 focus:outline-none"
                        >
                        <button type="submit" class="bg-gray-100 p-2 hover:bg-gray-200 transition duration-300">
                            <svg class="w-6 h-6 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                        </button>
                    </form>
                </div>
            </div>

            <!-- Cart and User Icons -->
            <div class="absolute right-4 top-16 flex items-center space-x-4">
                <a href="/checkout" class="relative p-2 rounded-full hover:bg-gray-100 transition duration-300">
                    <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                    <span id="cartCounter" class="absolute top-0 right-0 inline-flex items-center justify-center px-2 py-1 text-xs font-bold leading-none text-red-100 transform translate-x-1/2 -translate-y-1/2 bg-red-600 rounded-full">0</span>
                </a>
                <a href="#" class="p-2 rounded-full hover:bg-gray-100 transition duration-300">
                    <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                </a>
            </div>
        </div>

        <!-- Tagline Section -->
        <div class="text-center py-8 bg-gray-50">
            <h1 class="text-4xl font-serif mb-2">The Essence of Elegance</h1>
            <p class="text-gray-600 italic">Crafting memories, one scent at a time.</p>
        </div>
    </header>
    @endif
  

  
    {{--@!section('content') --}}
    {{{ await $slots.main() }}}
  

  
    {{-- Your site footer --}}
    @if ($slots.footer)
    {{{
      await $slots.footer()
    }}}
    @else
      <footer class="bg-gray-800 mt-12">
        <div class="container mx-auto px-4 py-8 text-center text-gray-400">
            <p>&copy; 2025 AdonisShop. All rights reserved. | Built with AdonisJS & Tailwind CSS</p>
        </div>
      </footer>
    @endif
  
</body>
</html>
