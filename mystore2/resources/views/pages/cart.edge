<script>
document.addEventListener('DOMContentLoaded', function() {
    // Select all checkboxes
    const selectAllCheckbox = document.querySelector('input[type="checkbox"]');
    const itemCheckboxes = document.querySelectorAll('.space-y-6 input[type="checkbox"]');
    
    // Handle "Select All" functionality
    selectAllCheckbox.addEventListener('change', function() {
        itemCheckboxes.forEach(checkbox => {
            checkbox.checked = this.checked;
        });
    });

    // Quantity buttons functionality
    document.querySelectorAll('.flex.items-center.space-x-3').forEach(container => {
        const minusBtn = container.querySelector('button:first-child');
        const plusBtn = container.querySelector('button:last-child');
        const input = container.querySelector('input');

        minusBtn.addEventListener('click', () => {
            if (input.value > 1) {
                input.value = parseInt(input.value) - 1;
            }
        });

        plusBtn.addEventListener('click', () => {
            input.value = parseInt(input.value) + 1;
        });
    });
});
</script>
@end