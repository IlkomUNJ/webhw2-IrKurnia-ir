<script>
document.addEventListener('DOMContentLoaded', function() {
    // Payment method selection
    const paymentOptions = document.querySelectorAll('input[name="payment"]');
    paymentOptions.forEach(option => {
        option.addEventListener('change', function() {
            // Reset all borders
            paymentOptions.forEach(opt => {
                opt.closest('.border').classList.remove('border-gray-800');
                opt.closest('.border').classList.add('border-gray-200');
            });
            
            // Highlight selected option
            if (this.checked) {
                this.closest('.border').classList.remove('border-gray-200');
                this.closest('.border').classList.add('border-gray-800');
            }
        });
    });

    // Form validation example
    const checkoutButton = document.querySelector('button:last-child');
    checkoutButton.addEventListener('click', function(e) {
        e.preventDefault();
        // Add your validation and submission logic here
        alert('Terima kasih! Pesanan Anda sedang diproses.');
    });
});
</script>
